# ==============================================================================
# Pharma Supply Chain Intelligence - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS
# DO NOT COMMIT THE REAL .env FILE TO GIT!
# ==============================================================================

# Application & Environment
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Storage & Lakehouse Paths (Local or Cloud/ADLS/S3)
DATA_DIR=./data
BRONZE_PATH=./data/bronze
SILVER_PATH=./data/silver
GOLD_PATH=./data/gold
DATA_SAMPLES_PATH=./data_samples

# Databricks Free Edition / Community Edition (POC)
DATABRICKS_HOST=https://community.cloud.databricks.com
DATABRICKS_TOKEN=your_databricks_pat_here
DATABRICKS_CLUSTER_ID=your_cluster_id_here
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id_optional

# Apache Airflow
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER=./dags

# RAG & LLM Configuration
# Choose LLM Provider: openai, huggingface, or local_ollama
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Vector Database
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_PATH=./vector_store
COLLECTION_NAME=pharma_regulatory_docs

# FastAPI & Streamlit Service Config
API_HOST=0.0.0.0
API_PORT=8000
STREAMLIT_PORT=8501
BACKEND_API_URL=http://localhost:8000

# Optional Operational Database (PostgreSQL / SQL Server)
# Only configure if independent operational DB is approved in decisions.md
USE_OPERATIONAL_DB=False
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pharma_db
DB_USER=pharma_user
DB_PASSWORD=your_password
